            description: "Sampling temperature 0-1. Ignored if thinking=true (forced to 1)"
          },
          thinking: {
            type: "boolean",
            description: "Enable extended thinking. Incompatible with outputFormat/outputSchema"
          },
          thinkingBudget: {
            type: "number",
            description: "Token budget for thinking (1024-100000). Defaults to 10000"
          },
          outputFormat: {
            type: "string",
            enum: ["summary", "classification", "extraction", "analysis", "comparison", "validation"],
            description: "Predefined output format. Incompatible with thinking"
          },
          outputSchema: {
            type: "object",
            description: "Custom JSON Schema. Incompatible with thinking",
            properties: {
              type: { type: "string", const: "object" },
              properties: { type: "object" },
              required: { type: "array", items: { type: "string" } }
            },
            required: ["type", "properties"]
          }
        },
        required: ["prompt"]
      }
    }
  ];
}
function setupSignalHandlers() {
  const shutdown = (signal) => {
    console.error(`Session MCP Server received ${signal}, shutting down gracefully`);
    process.exit(0);
  };
  process.on("SIGTERM", () => shutdown("SIGTERM"));
  process.on("SIGINT", () => shutdown("SIGINT"));
  process.on("unhandledRejection", (reason) => {
    console.error("Unhandled promise rejection in session MCP server:", reason);
  });
}
async function main() {
  setupSignalHandlers();
  const args = process.argv.slice(2);
  let sessionId;
  let workspaceRootPath;
  let plansFolderPath;
  for (let i = 0;i < args.length; i++) {
    if (args[i] === "--session-id" && args[i + 1]) {
      sessionId = args[i + 1];
      i++;
    } else if (args[i] === "--workspace-root" && args[i + 1]) {
      workspaceRootPath = args[i + 1];
      i++;
    } else if (args[i] === "--plans-folder" && args[i + 1]) {
      plansFolderPath = args[i + 1];
      i++;
    }
  }
  if (!sessionId || !workspaceRootPath || !plansFolderPath) {
    console.error("Usage: session-mcp-server --session-id <id> --workspace-root <path> --plans-folder <path>");
    process.exit(1);
  }
  const config2 = {
    sessionId,
    workspaceRootPath,
    plansFolderPath
  };
  const ctx = createCodexContext(config2);
  const server = new Server({
    name: "craft-agent-session",
    version: "0.3.1"
  }, {
    capabilities: {
      tools: {}
    }
  });
  server.setRequestHandler(ListToolsRequestSchema, async () => ({
    tools: createTools()
  }));
  server.setRequestHandler(CallToolRequestSchema, async (request) => {
    const { name, arguments: toolArgs } = request.params;
    try {
      switch (name) {
        case "SubmitPlan":
          return await handleSubmitPlan(ctx, toolArgs);
        case "config_validate":
          return await handleConfigValidate(ctx, toolArgs);
        case "skill_validate":
          return await handleSkillValidate(ctx, toolArgs);
        case "mermaid_validate":
          return await handleMermaidValidate(ctx, toolArgs);
        case "source_oauth_trigger":
          return await handleSourceOAuthTrigger(ctx, toolArgs);
        case "source_google_oauth_trigger":
          return await handleGoogleOAuthTrigger(ctx, toolArgs);
        case "source_slack_oauth_trigger":
          return await handleSlackOAuthTrigger(ctx, toolArgs);
        case "source_microsoft_oauth_trigger":
          return await handleMicrosoftOAuthTrigger(ctx, toolArgs);
        case "source_credential_prompt":
          return await handleCredentialPrompt(ctx, toolArgs);
        case "source_test":
          return await handleSourceTest(ctx, toolArgs);
        case "call_llm":
          return await handleCallLlm(ctx, toolArgs);
        default:
          return errorResponse(`Unknown tool: ${name}`);
      }
    } catch (error3) {
      return errorResponse(`Tool '${name}' failed: ${error3 instanceof Error ? error3.message : String(error3)}`);
    }
  });
  const transport = new StdioServerTransport;
  await server.connect(transport);
  console.error(`Session MCP Server started for session ${sessionId}`);
}
main().catch((error3) => {
  console.error("Fatal error:", error3);
  process.exit(1);
});
