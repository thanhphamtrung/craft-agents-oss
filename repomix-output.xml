/** Processing indicator with cycling messages and elapsed time */
const PROCESSING_MESSAGES = [
  'Thinking…',
  'Pondering…',
  'Contemplating…',
  'Reasoning…',
  'Processing…',
  'Computing…',
  'Considering…',
  'Reflecting…',
