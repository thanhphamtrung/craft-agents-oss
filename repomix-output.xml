    expect(isMermaidFilename('flow.MERMAID')).toBe(true)
    expect(isMermaidFilename('notes.md')).toBe(false)
    expect(isMermaidFilename('image.png')).toBe(false)
  })

  it('extracts source from fenced mermaid block', () => {
