      expect(onPromptsReady).toHaveBeenCalledTimes(1);
      const prompts: PendingPrompt[] = onPromptsReady.mock.calls[0]![0];
      expect(prompts[0]!.prompt).toContain('priority');
      expect(prompts[0]!.prompt).toContain('test-workspace');

      handler.dispose();
