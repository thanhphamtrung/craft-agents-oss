                for tag_id, value in exif.items():
                    tag_name = ExifTags.TAGS.get(tag_id, str(tag_id))
                    try:
                        exif_data[tag_name] = str(value)
                    except Exception:
                        exif_data[tag_name] = repr(value)
        except Exception:
            pass

        if exif_data:
            info_dict["exif"] = exif_data

        # Animation info
        if hasattr(img, "n_frames"):
