                              <Icon className="h-3 w-3" />
                              {meta.label}
                            </span>
                          </div>
                          <p className="text-[11px] text-foreground/60 leading-relaxed">{snap.summary}</p>
                          <div className="mt-1 text-[10px] text-foreground/45">Updated {snap.lastUpdated}</div>
